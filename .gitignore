### Go ###
# bin/ holds the tracked family launcher (bin/gruff-go.sh) plus local build
# output: scripts/build-bin-gruff-go.sh, the perf harness, and the launcher build
# the compiled gruff-go binary into bin/ on demand. That binary is a ~12 MB
# platform-specific artifact - never tracked; only the launcher is committed.
/bin/*
!/bin/gruff-go.sh
# Root build artifact from `go build ./cmd/gruff-go` (anchored so it does not
# match the cmd/gruff-go source directory).
/gruff-go
*.out
coverage.out
coverage.html
go.work
go.work.sum

### Node / Tooling ###
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

### Build / Runtime ###
/build/
/dist/
/output/
*.cache
*.log
# gruff-php writes its result cache to the current working directory
# (ResultCache::DIRECTORY = '.gruff-cache'), so running a sibling port from this
# checkout drops it here. `*.cache` above does not match it - the name ends in
# "-cache", not ".cache" - so a `git add -A` would otherwise stage it.
.gruff-cache/

### Performance harness (scripts/test-performance.sh) ###
/scripts/.perf-corpus/
/scripts/.tools/
/scripts/.perf-results/
!/scripts/.perf-results/baseline.json
