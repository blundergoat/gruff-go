# Auto-detect text files and normalize line endings to LF.
* text=auto eol=lf

# Shell scripts must always be LF. CRLF breaks shebangs on Linux/macOS.
*.sh text eol=lf

# Go files.
*.go text eol=lf

# Common source and config files.
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
*.toml text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
Makefile text eol=lf

# Binary files.
*.gif binary
*.ico binary
*.jpeg binary
*.jpg binary
*.pdf binary
*.png binary
*.ttf binary
*.woff binary
*.woff2 binary

# --- Release archive hygiene (export-ignore) ---
# `go install` / `go get` and proxy.golang.org build the module zip by running
# `git archive` (golang.org/x/mod/zip CreateFromVCS, search the toolchain source
# for `archive --format=zip`), which honours `export-ignore`. So these entries
# keep agent/dev-harness files out of the consumed module zip and every other
# `git archive` output. The paths stay tracked in git and are read from the
# working tree by CI, the agent hooks, and the scanner itself, so only downloaded
# archives are trimmed. Runtime/user-facing files (cmd/, internal/, docs/,
# README.md, LICENSE, CHANGELOG.md, go.mod) are intentionally NOT listed here.

# Agent and CI/dev-harness directories.
/.agents export-ignore
/.claude export-ignore
/.codex export-ignore
/.github export-ignore
/.goat-flow export-ignore

# Agent instruction files.
/AGENTS.md export-ignore
/CLAUDE.md export-ignore

# Peer-agent ignore/config files (no runtime use to an installed tool).
/.cursorignore export-ignore
/.copilotignore export-ignore
/.geminiignore export-ignore

# Build artifacts: the compiled bin/gruff-go binary is gitignored and all of bin/
# is export-ignored, so neither a force-added binary nor the tracked
# bin/gruff-go.sh launcher reaches a release archive (module consumers run the
# installed binary, not the launcher).
/bin export-ignore
