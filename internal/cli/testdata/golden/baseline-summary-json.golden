            "defaultEnabled": true,
            "tags": [
              "filesystem",
              "path-traversal",
              "security"
            ],
            "remediation": "Constrain request-derived paths with filepath.Clean plus a containment check (filepath.Rel/IsLocal) or reduce them to a basename before opening files."
