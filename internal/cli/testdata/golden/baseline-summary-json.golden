                "obj",
                "todo",
                "thing",
                "stuff"
              ]
            },
            "tags": [
              "naming"
            ],
            "remediation": "Rename the identifier to something that names its role, or remove it if it is no longer needed."
          },
          {
            "id": "naming.misspelling",
            "title": "Misspelled identifier or comment",
            "description": "Flags identifiers, doc comments, and struct tags containing common programming misspellings.",
            "pillar": "naming",
            "severity": "advisory",
            "confidence": "medium",
            "capability": "parser",
            "defaultEnabled": true,
            "options": {
              "extra": {},
              "ignore": []
            },
            "tags": [
              "naming"
            ],
            "remediation": "Replace the misspelled token with the suggested correction. Use the `ignore` option for project-specific terms that look like misspellings but are intentional (proper nouns, vendor-specific terms)."
          },
          {
            "id": "naming.negated-boolean",
            "title": "Negated boolean",
            "description": "Flags boolean identifiers whose names start with negation prefixes (No, Not, Disable, etc.), which force double-negation at call sites.",
            "pillar": "naming",
            "severity": "advisory",
            "confidence": "medium",
            "capability": "parser",
            "defaultEnabled": true,
            "options": {
              "allowList": [
                "NoOp",
                "Notify",
                "Notice",
                "Now",
                "NoCopy",
                "Notation",
                "Notebook",
                "NoConfig",
                "NoBaseline",
                "NoInteraction"
              ],
              "prefixes": [
                "No",
                "Not",
                "Disable",
                "Disallow",
                "Without",
                "Suppress"
              ],
              "scope": "exported"
            },
            "tags": [
              "go-style",
              "naming"
            ],
            "remediation": "Rename to the positive form (e.g. Skip… instead of No…) so call sites read without double negation."
          },
          {
            "id": "naming.package-stutter",
            "title": "Package stutter",
            "description": "Flags exported identifiers whose lowercase form starts with their own package name (config.ConfigOptions, rule.RuleRegistry).",
            "pillar": "naming",
            "severity": "advisory",
            "confidence": "medium",
            "capability": "parser",
