{
  "schemaVersion": "gruff.analysis.v2",
  "tool": {
    "name": "gruff-go",
    "version": "0.5.0"
  },
  "run": {
    "workingDirectory": "<WORKDIR>",
    "inputs": [
      "composite.go"
    ],
    "format": "summary-json",
    "failOn": "advisory"
  },
  "summary": {
    "filesScanned": 1,
    "filesSkipped": 0,
    "diagnosticsCount": 0,
    "findingsCount": 4,
    "countsBySeverity": {
      "advisory": 2,
      "error": 0,
      "warning": 2
    },
    "countsByPillar": {
      "complexity": 1,
      "design": 1,
      "documentation": 1,
      "size": 1
    },
    "exitCode": 1,
    "parserMode": "parser-only",
    "typeLoadingEnabled": false
  },
  "baseline": {
    "applied": false,
    "entries": 0,
    "suppressedFindings": 0,
    "staleEntries": 0,
    "newFindings": 0,
    "unchangedFindings": 0,
    "resolvedFindings": 0
  },
  "diff": {
    "enabled": false,
    "changedFiles": [],
    "filteredFindings": 0
  },
  "displayFilter": {
    "applied": false,
    "includeRules": [],
    "excludeRules": [],
    "includePillars": [],
    "excludePillars": [],
    "hiddenFindings": 0
  },
  "score": {
    "composite": 97,
    "grade": "A",
    "pillars": {
      "complexity": 96,
      "documentation": 99,
      "size": 96
    },
    "pillarDetails": [
      {
        "pillar": "complexity",
        "score": 96,
        "grade": "A",
        "findings": 1,
        "advisory": 0,
        "warning": 1,
        "error": 0,
        "penalty": 4
      },
      {
        "pillar": "documentation",
        "score": 99,
        "grade": "A",
        "findings": 1,
        "advisory": 1,
        "warning": 0,
        "error": 0,
        "penalty": 1
      },
      {
        "pillar": "size",
        "score": 96,
        "grade": "A",
        "findings": 1,
        "advisory": 0,
        "warning": 1,
        "error": 0,
        "penalty": 4
      }
    ],
    "coverage": {
      "contributingPillars": [
        "complexity",
        "documentation",
        "size"
      ]
    },
    "topOffenders": [
      {
        "file": "composite.go",
        "penalty": 9,
        "findings": 3,
        "grade": "A",
        "maxCyclomatic": 3
      }
    ],
    "complexityDistribution": {
      "1-5": 1,
      "11-15": 0,
      "16-20": 0,
      "21+": 0,
      "6-10": 0
    },
    "complexityDistributionScope": "finding-only"
  },
  "diagnostics": []
}
